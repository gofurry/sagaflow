# Local configuration and secrets
.env
.env.*
!.env.example
configs/config.yaml

# Runtime data
data/
logs/
bin/*
!bin/.gitkeep
dist/
tmp/

# Go
*.exe
*.test
coverage.out

# Frontend
web/node_modules/
web/dist/
web/.vite/
web/.env
web/.env.*
!web/.env.example

# The production UI is embedded into the Go binary and must stay trackable
# even though other build output directories are ignored.
!internal/webui/dist/
!internal/webui/dist/**

# Editors and OS files
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

design-qa.md
